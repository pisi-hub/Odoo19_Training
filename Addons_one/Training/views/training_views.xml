<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Training List View -->
    <record id="view_training_list" model="ir.ui.view">
        <field name="name">training.training.list</field>
        <field name="model">training.training</field>

        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="trainer"/>
                <field name="date"/>
                <field name="duration"/>
            </list>
        </field>
    </record>


    <!-- Training Form View -->
    <record id="view_training_form" model="ir.ui.view">
        <field name="name">training.training.form</field>
        <field name="model">training.training</field>

        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="trainer"/>
                        <field name="date"/>
                        <field name="duration"/>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>


    <!-- Training Action -->
    <record id="action_training" model="ir.actions.act_window">
        <field name="name">Training</field>
        <field name="res_model">training.training</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>